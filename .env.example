NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Production deployment only. Never enable this in local, test, or preview environments.
NEXT_PUBLIC_BIS_ALLOW_PRODUCTION_SUPABASE=false
NEXT_PUBLIC_APP_URL=https://www.bisportal.online
NEXT_PUBLIC_SITE_URL=https://www.bisportal.online
# Authentication uses the canonical origin in lib/auth-redirect.ts.
# Localhost callbacks are supported for local development.

# Commercial Intelligence and governed Evidence Intelligence use Vercel AI Gateway.
# Vercel deployments receive VERCEL_OIDC_TOKEN automatically.
# AI_GATEWAY_API_KEY is only needed for local/non-Vercel runtimes.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=openai/gpt-5.6-luna

# Evidence Intelligence is off by default. Enable only after the relevant free-text
# questions have ACTIVE + MODEL_ASSISTED registry policy and approved curriculum mappings.
# This flag is server-side; do not expose it through NEXT_PUBLIC_* configuration.
BIS_EVIDENCE_AI_ENABLED=false
# Optional model override. Falls back to AI_GATEWAY_MODEL.
BIS_EVIDENCE_AI_MODEL=openai/gpt-5.6-luna
# Outputs below this confidence threshold are forced to human review.
BIS_EVIDENCE_AI_MIN_CONFIDENCE=0.80
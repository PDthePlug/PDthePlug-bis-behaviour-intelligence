{
  "name": "bis-behaviour-intelligence",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "runtime:check": "node scripts/check-node-version.mjs",
    "preinstall": "node scripts/check-node-version.mjs",
    "dev": "npm run runtime:check && next dev",
    "content:compile": "npm run runtime:check && node scripts/compile-learning-cartridges.mjs",
    "prebuild": "npm run content:compile",
    "build": "next build",
    "start": "npm run runtime:check && next start",
    "vercel-build": "npm run verify:build",
    "verify": "npm run verify:build && npm run test:browser",
    "typecheck": "npm run runtime:check && tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:acceptance": "npm run runtime:check && node --test tests/*.test.mjs",
    "audit:source": "npm run runtime:check && node scripts/audit-canonical-sources.mjs",
    "test:browser": "npm run runtime:check && playwright test",
    "test:staging": "npm run runtime:check && playwright test --config=playwright.staging.config.ts",
    "lint": "npm run runtime:check && eslint . --ignore-pattern dist --ignore-pattern .next",
    "verify:build": "npm run runtime:check && npm run lint && npm run typecheck && npm run test:acceptance && npm run audit:source && npm run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.7",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sanitize-html": "^2.17.7",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/sanitize-html": "^2.16.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.7",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  },
  "type": "module"
}
